# ============================================================
# 数字人视频流水线 · 配置文件（API 密钥从本文件读取）
# 也可以把密钥集中放在 secrets/.api_keys.json（字段见 .api_keys.example.json）
# ============================================================

# ---- 控制台 ----
PORT=7788

# ---- MiniMax（Step2 TTS）----
# 密钥也可以通过 `mmx auth login --api-key <密钥>` 持久化到 ~/.mmx/config.json
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-hd
# TTS 超时（毫秒）
MINIMAX_TTS_TIMEOUT_MS=900000

# ---- AI 文本生成（puck SDK 主路径 / codex CLI fallback）----
# 流水线 Step1（文案）+ Step4（字幕）默认走 puck SDK（@puckguo123/sdk，file: 引用 puck-agent/puck/packages/sdk）
# 留空走系统默认优先级表：minimax → openai → anthropic → zai-coding-cn → minimax-cn → ...（详见 server/pi_runner.mjs PROVIDER_PRIORITY）
# 显式指定：PUCK_MODEL=provider/modelId，例如：
#   PUCK_MODEL=minimax/MiniMax-M3
#   PUCK_MODEL=openai/gpt-5.1
#   PUCK_MODEL=anthropic/claude-sonnet-4-5
PUCK_MODEL=
PUCK_TIMEOUT_MS=600000

# 至少需要配置一个 provider 的 API Key（按系统默认优先级生效）：
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 也可显式配 ZAI_CODING_CN_API_KEY（GLM Coding）/ MINIMAX_CN_API_KEY（国内 MiniMax）等

# ---- Codex CLI（已弃用，仅作 puck 失败时的 fallback）----
# 留空使用 codex 默认模型；例如 gpt-5.1-codex-mini
CODEX_MODEL=
CODEX_TIMEOUT_MS=600000

# ---- HeyGen（Step3 数字人，Remote MCP + OAuth）----
# 官方 CLI 不支持 Windows，已改用 HeyGen Remote MCP（https://mcp.heygen.com/mcp/v1/）
# 连接方式：控制台「环境检查」页 → 「🔗 连接 HeyGen」→ 浏览器 OAuth 授权，无需 API Key
# 默认数字人 Avatar ID（前端预填，可在表单/「浏览数字人」中覆盖）
HEYGEN_AVATAR_ID=
# 访问 mcp.heygen.com 需代理时配置（如 Clash：http://127.0.0.1:7890）
HEYGEN_PROXY=http://127.0.0.1:7890
# 数字人视频生成+轮询+下载的超时（毫秒）
HEYGEN_TIMEOUT_MS=1800000

# ---- FFmpeg（Step6 压缩 / 媒体校验）----
# 默认使用 PATH 中的 ffmpeg / ffprobe，可填绝对路径
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- LivePortrait（Step3 可选数字人 provider，本地推理）----
# 仓库路径默认为项目根 LivePortrait/（git clone https://github.com/KlingTeam/LivePortrait 后手动改名为 LivePortrait）
# Python 解释器路径；推荐在 LivePortrait/ 下 conda create -n LivePortrait python=3.10 后填这里，如：
#   LIVEPORTRAIT_PYTHON=C:\Users\Administrator\miniconda3\envs\LivePortrait\python.exe
# 留空则使用 PATH 中的 python
LIVEPORTRAIT_PYTHON=
# 推理超时（毫秒）
LIVEPORTRAIT_TIMEOUT_MS=1800000
